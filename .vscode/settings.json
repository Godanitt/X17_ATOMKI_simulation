{
  "files.associations": {
    "*.C": "cpp",
    "*.hh": "cpp",
    "*.icc": "cpp",
    "iostream": "cpp",
    "vector": "cpp",
    "string": "cpp",
    "fstream": "cpp",
    "cmath": "cpp",
    "algorithm": "cpp"
  },
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
  "C_Cpp.default.compilerPath": "/usr/bin/g++",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "C_Cpp.errorSquiggles": "enabled",
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.linux": {
    "ROOTSYS": "/home/daniel/root-install",
    "PATH": "/home/daniel/root-install/bin:/home/daniel/geant4-install/bin:${env:PATH}",
    "LD_LIBRARY_PATH": "/home/daniel/root-install/lib:/home/daniel/geant4-install/lib:${env:LD_LIBRARY_PATH}",
    "PYTHONPATH": "/home/daniel/root-install/lib:${env:PYTHONPATH}"
  }
}
